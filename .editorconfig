# Manual de Buenas Prácticas de Código, secciones 2.3, 2.3.1, 2.3.2, 2.3.3.
# Fuente: developer.android.com/kotlin/style-guide (Formatting).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4                 # sección 2.3
max_line_length = 100           # sección 2.3
insert_final_newline = true
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Sección 2.3.1 — llaves obligatorias salvo if/when de una línea.
ktlint_standard_curly-spacing = enabled
# Sección 2.3.2 — espaciado horizontal (operadores, comas, llaves).
ktlint_standard_op-spacing = enabled
ktlint_standard_comma-spacing = enabled
ktlint_standard_colon-spacing = enabled
# Sección 2.3.3 — salto de línea: parámetro por línea si no cabe en 100 cols.
ktlint_standard_parameter-list-wrapping = enabled
ktlint_standard_argument-list-wrapping = enabled

[*.{yml,yaml,toml}]
indent_size = 2
